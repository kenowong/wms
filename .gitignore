# ===== 构建产物 / 打包二进制（体积大，不上传） =====
tesseract/
dist/
build/
dist_bak/
build_bak/
*.exe

# 顶层 installer 目录全是安装包 exe
/installer/

# wms_app 内部 installer 的 exe 与构建中间文件
wms_app/installer/*.exe
wms_app/installer/build/

# 但保留安装/构建脚本源码
!wms_app/installer.iss
!wms_app/wms.spec
!wms_app/进销存管理系统.spec
!wms_app/installer/create_installer.py
!wms_app/installer/install.bat
!wms_app/installer/installer.sed
!wms_app/installer/setup.iss

